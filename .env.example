# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/kirana_khata?retryWrites=true&w=majority&appName=KiranaCluster"

# Application Secrets
JWT_SECRET="kirana-production-secret-key-2026-safe-for-rural-store"
NEXT_PUBLIC_APP_NAME="Rural Kirana Accounts"
NODE_ENV="development"
